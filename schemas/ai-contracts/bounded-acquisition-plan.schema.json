{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bounded-acquisition-plan.schema.json",
  "title": "BoundedAcquisitionPlan",
  "description": "Policy-backed finite plan for one logical provider search. acquisition_budget and maximum_internal_acquisitions must come from AcquisitionBudgetPolicy. Concrete Facebook Venezuela partition catalogs belong to OpenSpec PR D and must not appear here as if implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "acquisition_budget",
    "maximum_internal_acquisitions",
    "steps"
  ],
  "properties": {
    "provider": {
      "type": "string",
      "enum": ["alibaba", "facebook", "mercadolibre"]
    },
    "acquisition_budget": {
      "type": "integer",
      "minimum": 1
    },
    "maximum_internal_acquisitions": {
      "type": "integer",
      "minimum": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "candidate_limit"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "candidate_limit": { "type": "integer", "minimum": 1 },
          "required_for_complete_coverage": { "type": "boolean", "default": true }
        }
      }
    },
    "requested_geographic_scope": { "type": ["string", "null"] },
    "complete_effective_geographic_scope": { "type": ["string", "null"] },
    "partial_effective_geographic_scope": { "type": ["string", "null"] },
    "allow_early_termination": { "type": "boolean", "default": true }
  }
}
