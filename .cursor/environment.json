{
  "name": "BERA Price Tracker",
  "install": "bash .cursor/install.sh && bash .cursor/install-gitnexus.sh",
  "start": "bash .cursor/start-gitnexus.sh",
  "terminals": [
    {
      "name": "reflex",
      "command": ".venv/bin/reflex run"
    }
  ],
  "ports": [
    {
      "name": "frontend",
      "port": 3000
    },
    {
      "name": "backend",
      "port": 8000
    }
  ]
}
