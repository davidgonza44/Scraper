# The application reads the process environment directly. This file is documentation only.
BERA_TRACKER_LOG_LEVEL=INFO
BERA_TRACKER_DATABASE_PATH=data/bera_price_tracker.db

# Mercado Libre API configuration. Leave secrets empty in source control.
BERA_TRACKER_MERCADOLIBRE_SITE_ID=
BERA_TRACKER_MERCADOLIBRE_CLIENT_ID=
BERA_TRACKER_MERCADOLIBRE_CLIENT_SECRET=
BERA_TRACKER_MERCADOLIBRE_ACCESS_TOKEN=
BERA_TRACKER_MERCADOLIBRE_PAGE_SIZE=50
BERA_TRACKER_MERCADOLIBRE_MAX_PAGES=3
BERA_TRACKER_MERCADOLIBRE_TIMEOUT_SECONDS=10
BERA_TRACKER_MERCADOLIBRE_MAX_RETRIES=2

# Bright Data Facebook Marketplace provider (experimental/legacy, not default).
# Never commit a real API token.
BERA_TRACKER_BRIGHTDATA_API_TOKEN=
BERA_TRACKER_BRIGHTDATA_BASE_URL=https://api.brightdata.com
BERA_TRACKER_BRIGHTDATA_DATASET_ID=gd_lvt9iwuh6fbcwmx1a
BERA_TRACKER_BRIGHTDATA_TIMEOUT_SECONDS=70
BERA_TRACKER_BRIGHTDATA_POLL_INTERVAL_SECONDS=5
BERA_TRACKER_BRIGHTDATA_POLL_TIMEOUT_SECONDS=900
BERA_TRACKER_FACEBOOK_CITY=caracas
BERA_TRACKER_FACEBOOK_RECORD_LIMIT=5

# Local Ollama API. Authentication for cloud models is managed by the Ollama installation.
BERA_TRACKER_OLLAMA_BASE_URL=http://localhost:11434
BERA_TRACKER_OLLAMA_MODEL=minimax-m3:cloud
BERA_TRACKER_OLLAMA_TIMEOUT_SECONDS=90
# Apify is the default Facebook Marketplace backend. Never commit a real token.
BERA_TRACKER_APIFY_API_TOKEN=
BERA_TRACKER_APIFY_ALIBABA_ACTOR=scraper-engine/alibaba-scraper
