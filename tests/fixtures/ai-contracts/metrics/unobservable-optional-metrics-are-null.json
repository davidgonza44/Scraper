{
  "id": "unobservable-optional-metrics-are-null",
  "description": "When fetched, mapped, or rejected cannot be observed truthfully, the value is null / unavailable, never numeric zero.",
  "provider": "alibaba",
  "implementation_stage": "A",
  "runtime_check": "search_session_core",
  "given": {
    "intent": {
      "original_user_query": "baseball glove",
      "display_limit": 3,
      "selected_providers": ["alibaba"],
      "generation": 7
    },
    "policy": {
      "alibaba": {
        "maximum_internal_acquisitions": 1,
        "maximum_acquisition_budget": 30,
        "candidate_buffer_multiplier": 3
      }
    },
    "steps": [{ "key": "step-1", "candidate_limit": 5 }],
    "batches": {
      "step-1": {
        "candidates": [{ "title": "one" }],
        "fetched": null,
        "mapped": null,
        "rejected": null
      }
    }
  },
  "expected": {
    "status": "SUCCESS",
    "metrics": {
      "display_requested": 3,
      "acquisition_budget": 9,
      "acquisition_requested": 5,
      "fetched": null,
      "mapped": null,
      "rejected": null,
      "usable": 1,
      "displayed": 1
    }
  },
  "must_not": [
    "report fetched as 0",
    "report mapped as 0",
    "report rejected as 0",
    "treat No disponible as numeric zero"
  ],
  "source_refs": [
    "openspec/changes/multi-market-search-semantics/specs/bounded-provider-search/spec.md",
    "openspec/changes/multi-market-search-semantics/design.md",
    "docs/architecture/README.md",
    "docs/architecture/multi-market-search-core.puml",
    "docs/architecture/multi-market-search-sequence.puml"
  ]
}
