{
  "id": "geographic-partial-empty-is-incidence",
  "description": "PARTIAL coverage with zero usable results is still an incidence. It must not be labelled a complete nationwide empty search.",
  "provider": "facebook",
  "implementation_stage": "A",
  "runtime_check": "search_session_core",
  "given": {
    "intent": {
      "original_user_query": "baseball glove",
      "display_limit": 3,
      "selected_providers": ["facebook"],
      "generation": 7,
      "requested_geographic_scopes": [
        { "provider": "facebook", "scope": "Toda Venezuela" }
      ]
    },
    "policy": {
      "facebook": {
        "maximum_internal_acquisitions": 2,
        "maximum_acquisition_budget": 30,
        "candidate_buffer_multiplier": 4
      }
    },
    "scope": "Toda Venezuela",
    "steps": [
      { "key": "step-1", "candidate_limit": 5, "required_for_complete_coverage": true },
      { "key": "step-2", "candidate_limit": 5, "required_for_complete_coverage": true }
    ],
    "batches": {
      "step-1": { "candidates": [] },
      "step-2": { "error": "failed" }
    }
  },
  "expected": {
    "status": "EMPTY",
    "coverage_status": "PARTIAL",
    "has_incidents": true,
    "completion_label": "Búsqueda completada con incidencias"
  },
  "must_not": [
    "say Búsqueda completada · Sin resultados",
    "claim complete nationwide empty coverage",
    "relabel PARTIAL as COMPLETE"
  ],
  "source_refs": [
    "openspec/changes/multi-market-search-semantics/design.md",
    "openspec/changes/multi-market-search-semantics/specs/marketplace-query-routing/spec.md",
    "docs/architecture/README.md",
    "docs/architecture/multi-market-search-core.puml",
    "docs/architecture/multi-market-search-sequence.puml"
  ]
}
