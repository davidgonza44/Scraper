{
  "id": "error-before-coverage-is-unavailable",
  "description": "ERROR before any truthful acquisition leaves coverage unavailable. It is neither COMPLETE nor PARTIAL.",
  "provider": "facebook",
  "implementation_stage": "A",
  "runtime_check": "search_session_core",
  "given": {
    "intent": {
      "original_user_query": "baseball glove",
      "display_limit": 3,
      "selected_providers": ["facebook"],
      "generation": 7,
      "requested_geographic_scopes": [
        { "provider": "facebook", "scope": "Toda Venezuela" }
      ]
    },
    "policy": {
      "facebook": {
        "maximum_internal_acquisitions": 1,
        "maximum_acquisition_budget": 30,
        "candidate_buffer_multiplier": 3
      }
    },
    "scope": "Toda Venezuela",
    "steps": [{ "key": "step-1", "candidate_limit": 5 }],
    "batches": {
      "step-1": { "error": "not configured" }
    }
  },
  "expected": {
    "status": "ERROR",
    "coverage_status": null,
    "effective_geographic_scope": null,
    "usable": 0,
    "displayed": 0,
    "completion_label": "Búsqueda con error"
  },
  "must_not": [
    "invent COMPLETE coverage",
    "invent PARTIAL coverage",
    "expose credentials, tokens, raw configuration, or stack traces"
  ],
  "source_refs": [
    "openspec/changes/multi-market-search-semantics/specs/marketplace-query-routing/spec.md",
    "openspec/changes/multi-market-search-semantics/design.md"
  ]
}
