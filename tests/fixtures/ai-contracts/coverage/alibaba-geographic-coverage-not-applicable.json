{
  "id": "alibaba-geographic-coverage-not-applicable",
  "description": "Alibaba generic search does not use geographic coverage. Non-applicable coverage does not create an incident by itself.",
  "provider": "alibaba",
  "implementation_stage": "A",
  "runtime_check": "search_session_core",
  "given": {
    "intent": {
      "original_user_query": "baseball glove",
      "display_limit": 3,
      "selected_providers": ["alibaba"],
      "generation": 7
    },
    "policy": {
      "alibaba": {
        "maximum_internal_acquisitions": 1,
        "maximum_acquisition_budget": 30,
        "candidate_buffer_multiplier": 3
      }
    },
    "steps": [{ "key": "step-1", "candidate_limit": 5 }],
    "batches": {
      "step-1": { "candidates": [{ "title": "one" }] }
    }
  },
  "expected": {
    "status": "SUCCESS",
    "coverage_status": null,
    "effective_geographic_scope": null,
    "has_incidents": false,
    "completion_label": "Búsqueda completada"
  },
  "must_not": [
    "create an incident from non-applicable Alibaba coverage",
    "force COMPLETE or PARTIAL onto Alibaba generic search"
  ],
  "source_refs": [
    "openspec/changes/multi-market-search-semantics/design.md",
    "openspec/changes/multi-market-search-semantics/specs/marketplace-query-routing/spec.md"
  ]
}
