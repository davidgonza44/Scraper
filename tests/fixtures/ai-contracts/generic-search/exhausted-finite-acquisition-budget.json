{
  "id": "exhausted-finite-acquisition-budget",
  "description": "When the approved budget cannot fund the next planned step, the logical search returns fewer results and stops.",
  "provider": "alibaba",
  "implementation_stage": "A",
  "runtime_check": "search_session_core",
  "given": {
    "intent": {
      "original_user_query": "baseball glove",
      "display_limit": 3,
      "selected_providers": ["alibaba"],
      "generation": 7
    },
    "policy": {
      "alibaba": {
        "maximum_internal_acquisitions": 2,
        "maximum_acquisition_budget": 5,
        "candidate_buffer_multiplier": 2
      }
    },
    "steps": [
      { "key": "step-1", "candidate_limit": 5 },
      { "key": "step-2", "candidate_limit": 5 }
    ],
    "batches": {
      "step-1": { "candidates": [{ "title": "only" }] },
      "step-2": { "candidates": [{ "title": "must-not-run" }] }
    }
  },
  "expected": {
    "status": "SUCCESS",
    "executed_steps": ["step-1"],
    "metrics": {
      "display_requested": 3,
      "acquisition_budget": 5,
      "acquisition_requested": 5,
      "fetched": 1,
      "mapped": 1,
      "rejected": 0,
      "usable": 1,
      "displayed": 1
    }
  },
  "must_not": [
    "continue indefinitely",
    "start unbounded pagination",
    "execute step-2 after the budget is exhausted",
    "fabricate listings to reach display_limit"
  ],
  "source_refs": [
    "openspec/changes/multi-market-search-semantics/specs/bounded-provider-search/spec.md",
    "openspec/changes/multi-market-search-semantics/design.md",
    "docs/architecture/README.md",
    "docs/architecture/multi-market-search-core.puml",
    "docs/architecture/multi-market-search-sequence.puml"
  ]
}
