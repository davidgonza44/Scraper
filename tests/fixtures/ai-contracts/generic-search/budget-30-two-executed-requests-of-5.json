{
  "id": "budget-30-two-executed-requests-of-5",
  "description": "acquisition_budget is the approved ceiling; acquisition_requested counts only executed internal work.",
  "provider": "alibaba",
  "implementation_stage": "A",
  "runtime_check": "search_session_core",
  "given": {
    "intent": {
      "original_user_query": "baseball glove",
      "display_limit": 10,
      "selected_providers": ["alibaba"],
      "generation": 7
    },
    "policy": {
      "alibaba": {
        "maximum_internal_acquisitions": 2,
        "maximum_acquisition_budget": 30,
        "candidate_buffer_multiplier": 3
      }
    },
    "steps": [
      { "key": "step-1", "candidate_limit": 5 },
      { "key": "step-2", "candidate_limit": 5 }
    ],
    "batches": {
      "step-1": { "candidates": [] },
      "step-2": { "candidates": [] }
    }
  },
  "expected": {
    "status": "EMPTY",
    "metrics": {
      "display_requested": 10,
      "acquisition_budget": 30,
      "acquisition_requested": 10,
      "fetched": 0,
      "mapped": 0,
      "rejected": 0,
      "usable": 0,
      "displayed": 0
    }
  },
  "must_not": [
    "report acquisition_requested as 30",
    "introduce acquisition_limit or another acquisition-volume concept",
    "count unused budget as requested work"
  ],
  "source_refs": [
    "openspec/changes/multi-market-search-semantics/specs/bounded-provider-search/spec.md",
    "openspec/changes/multi-market-search-semantics/design.md",
    "docs/architecture/README.md",
    "docs/architecture/multi-market-search-core.puml",
    "docs/architecture/multi-market-search-sequence.puml"
  ]
}
